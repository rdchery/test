ZENDESK_SUBDOMAIN=yourcompany
ZENDESK_EMAIL=agent@yourcompany.com
ZENDESK_API_TOKEN=paste_api_token_here

# From the webhook's "Signing Secret" in Admin Center -> Webhooks -- see
# README.md Step 3. Leave blank only for local testing.
ZENDESK_WEBHOOK_SIGNING_SECRET=

# Numeric IDs of the two custom fields created in Step 2. Find them at
# Admin Center -> Objects and rules -> Tickets -> Fields (click a field,
# the ID is in the URL), or via GET /api/v2/ticket_fields.json.
ZENDESK_PARENT_FIELD_ID=
ZENDESK_RELATIONSHIP_FIELD_ID=

# The stored value (the dropdown option's "tag", not its display label)
# that marks a ticket as a child rather than Related/Standalone. Matches
# the "Child of Ticket / Project" option's tag as configured.
ZENDESK_CHILD_RELATIONSHIP_VALUE=child_of_ticket_/_project

PORT=5000
LOG_LEVEL=INFO
