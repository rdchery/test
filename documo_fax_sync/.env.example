# --- Documo (mFax) API ---
DOCUMO_API_KEY=your_documo_api_key
DOCUMO_API_BASE=https://api.documo.com
# How the API key is sent. Documo's docs show "Authorization: Basic API_KEY".
DOCUMO_AUTH_HEADER=Authorization
DOCUMO_AUTH_SCHEME=Basic

# Endpoint paths -- list and download are confirmed working by live testing.
# mark-read is still an unconfirmed guess (see README); a failure there is
# logged as a warning but doesn't stop the fax from being saved/tracked.
#DOCUMO_LIST_PATH=/v1/fax/history
#DOCUMO_DOWNLOAD_PATH=/v1/fax/{fax_id}/download
#DOCUMO_MARK_READ_PATH=/v1/fax/{fax_id}

# --- Destination: pick ONE of the two options below ---

# Option A: a network share already mounted on this host
# (Windows mapped drive letter/UNC path, or a Linux CIFS/NFS mount point)
SHARE_DIR=/mnt/fax-share/incoming

# Option B: write directly over SMB without mounting anything.
# Only used if SMB_HOST is set (takes priority over SHARE_DIR).
#SMB_HOST=fileserver.corp.local
#SMB_SHARE=faxes
#SMB_USERNAME=svc-fax
#SMB_PASSWORD=changeme
#SMB_REMOTE_DIR=incoming
#SMB_PORT=445

# --- Behavior ---
STATE_FILE=processed_faxes.json
FILENAME_TEMPLATE={received_at}_{from_number}_{fax_id}.pdf
LOG_LEVEL=INFO

# Set to false while testing so downloaded faxes are saved to the share but
# NOT marked as read in Documo -- staff checking Documo's own inbox will
# still see them as unread/new. Leave as true (default) once you trust it,
# so Documo's inbox doesn't fill up with faxes already copied to the share.
MARK_AS_READ=true
